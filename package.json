{
  "name": "shipnow-backend3",
  "version": "1.0.0",
  "description": "Backend 2 - Diseño y Arquitectura Backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "npm run test:functional && npm run test:swagger",
    "test:swagger": "node --test tests/swagger.test.js",
    "test:functional": "node --env-file=.env.test ./node_modules/mocha/bin/mocha.js \"tests/functional/**/*.test.js\" --timeout 15000"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "nodemailer": "^9.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.1"
  }
}
